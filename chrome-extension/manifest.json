{
  "manifest_version": 3,
  "name": "Try1Second \u2014 Cross-Site Price History & Alerts",
  "short_name": "Try1Second",
  "version": "1.1.0",
  "description": "Live cross-site price comparison, real price history graphs and price-drop alerts \u2014 powered by the independent Try1Second metasearch engine. Never shows invented prices.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.try1second.com/*",
    "https://try1second.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Try1Second",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.in/dp/*",
        "https://www.amazon.in/*/dp/*",
        "https://www.flipkart.com/*",
        "https://www.myntra.com/*",
        "https://www.ajio.com/*",
        "https://www.tatacliq.com/*",
        "https://www.meesho.com/*"
      ],
      "js": [
        "lib/api.js",
        "lib/sites.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/logo-icon.png",
        "images/logo-wordmark.png",
        "images/logo-full.png"
      ],
      "matches": [
        "https://www.amazon.in/*",
        "https://www.flipkart.com/*",
        "https://www.myntra.com/*",
        "https://www.ajio.com/*",
        "https://www.tatacliq.com/*",
        "https://www.meesho.com/*"
      ]
    }
  ]
}