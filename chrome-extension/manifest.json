{
  "manifest_version": 3,
  "name": "Try1Second Price Tracker & Auto Coupon",
  "short_name": "Try1Second",
  "version": "1.8.5",
  "description": "Auto-grabs the page you are on, compares prices across sites, 365-day price history, price-drop alerts and 1-click Auto Coupon Tester for every major store.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.try1second.com/*",
    "https://try1second.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Try1Second",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.in/*",
        "https://www.flipkart.com/*",
        "https://www.myntra.com/*",
        "https://www.ajio.com/*",
        "https://www.tatacliq.com/*",
        "https://www.shopsy.in/*",
        "https://www.blinkit.com/*",
        "https://www.bigbasket.com/*",
        "https://www.zeptonow.com/*",
        "https://www.jiomart.com/*",
        "https://www.swiggy.com/*",
        "https://www.zomato.com/*",
        "https://www.dominos.co.in/*",
        "https://in.bookmyshow.com/*",
        "https://www.makemytrip.com/*",
        "https://www.goibibo.com/*",
        "https://www.easemytrip.com/*",
        "https://www.yatra.com/*",
        "https://www.cleartrip.com/*",
        "https://www.redbus.in/*",
        "https://www.abhibus.com/*"
      ],
      "js": [
        "lib/api.js",
        "lib/sites.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/*",
        "popup/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
