# ============================================================
# Try1Second — shared-hosting compatibility layer
# Works while the whole repo is deployed as the web root.
# The production bundle lives in ./dist/ (built with base=/).
# .htaccess bridges / -> ./dist/ so the SAME build works on
# static hosting and under the Node.js app (server.js, Passenger).
# On KVM4 this file is ignored (Node/nginx serves dist/).
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Canonical host: ONE-hop redirect (PageSpeed 'Avoid multiple page redirects') ---
  # http://try1second.com, http://www.try1second.com and https://try1second.com all
  # 301 straight to https://www.try1second.com/<path> in a SINGLE hop.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\.try1second\.com$ [NC]
  RewriteRule ^ https://www.try1second.com%{REQUEST_URI} [L,R=301]

  # Bundle assets referenced by dist/index.html (base=/ build)
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]
  RewriteRule ^(favicon\.ico|favicon-[0-9]+\.png|apple-touch-icon\.png|logo-(full|icon|wordmark|tagline)\.(png|webp))$ dist/$1 [L]

  # Serve the built SPA at the homepage
  RewriteRule ^$ dist/index.html [L]

  # SPA fallback for client-side routes (admininsta, merchantinstab2b, ...)
  # API paths are excluded so the backend (Node app) answers them itself.
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . dist/index.html [L]
</IfModule>

# --- Security: stop serving raw source code to the public ---
RedirectMatch 404 ^/(src|server|database|tests|node_modules|python-vendor|python-engine|\.git|\.data)(/|$).*
<FilesMatch "\.(ts|tsx|sql|env|lock|md)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(package\.json|tsconfig\.json|vite\.config\.ts|server\.ts|server\.js|metadata\.json|bun\.lock)$">
  Require all denied
</FilesMatch>


# ============================================================
# Performance layer (15 Oct, PageSpeed 67% -> recovery)
# ============================================================

# --- Gzip compression (covers Apache-served dist/assets/*; Node output is
# --- gzipped by the Express compression middleware) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml application/rss+xml image/x-icon
  AddOutputFilterByType DEFLATE font/ttf font/otf font/opentype application/font-woff
</IfModule>

# --- 1-year immutable browser cache for hashed static assets ---
# Vite names /assets/* with content hashes; they can NEVER change, so
# Cache-Control: public, max-age=31536000, immutable is safe. index.html is
# excluded (FilesMatch does not touch .html) and stays no-store from Express.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|woff2?|ttf|otf|eot|png|jpe?g|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Apache-served HTML (SPA fallback) must never be browser-cached across deploys
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  # 1 hour default (NOT 1 month): keeps Apache-served HTML reasonably fresh;
  # the no-cache header above is the real HTML guard.
  ExpiresDefault "access plus 1 hour"
</IfModule>
