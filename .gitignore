# Build output is generated on the deploy host (npm run build). Tracking it made a
# locally rebuilt dist block git pull on the server, so deploys silently kept the
# OLD source. dist stays out of git from now on.
dist

# runtime proxy state (regenerated by sweeps; never a repo artifact)
data/proxy-pool-gated.json
data/gate-heal.json
