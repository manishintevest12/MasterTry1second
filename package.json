{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "node --import tsx scripts/gen-applink-static.mjs && vite build && node scripts/defer-app-css.mjs && npm run build:server",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:server": "esbuild server.prod.ts --bundle --platform=node --format=cjs --target=node18 --packages=external --outfile=server.cjs",
    "start:prod": "node server.cjs",
    "build:cron": "esbuild server/cron/warm.ts --bundle --platform=node --format=cjs --target=node18 --packages=external --outfile=cron.cjs",
    "cron:prod": "node cron.cjs",
    "cron:dev": "tsx server/cron/warm.ts",
    "build:cron:affiliate": "esbuild server/cron/affiliateSync.ts --bundle --platform=node --format=cjs --target=node18 --packages=external --outfile=affiliate-sync.cjs",
    "sync:affiliate": "node affiliate-sync.cjs",
    "acceptance": "tsx server/registry/acceptanceCli.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.8.1",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "ioredis": "^6.0.0",
    "jsdom": "^30.1.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "re2js": "2.8.7",
    "undici@7.30.0": "7.30.1",
    "qs@6.16.0": "6.16.1",
    "fast-uri@3.1.8": "3.1.9",
    "body-parser": "1.20.9"
  }
}
