# ============ Try1Second — environment template ============
# Core
DATABASE_URL=mysql://user:pass@host:3306/dbname
REDIS_URL=                      # optional; L1+MySQL work without it
GEMINI_API_KEY=                 # optional AI query-understanding

# Affiliate networks — add credentials as each publisher account is approved.
# Sync auto-enables per network the moment its key pair is present.
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=
ADMITAD_WEBSITE_ID=             # Admitad website (ad space) id
ADMITAD_DEFAULT_CAMPAIGN_ID=    # optional fallback campaign for deeplinks
ADMITAD_BASE_URL=https://api.admitad.com
ADMITAD_SCOPE=advcampaigns_for_website coupons_for_website

VCOMMISSION_API_KEY=
VCOMMISSION_BASE_URL=https://api.vcommission.com/v2

CUELINKS_API_KEY=               # skeleton adapter ready
CUELINKS_CAMPAIGN_ID=
CUELINKS_SUB_ID=

# OPTIMISE_API_KEY=             # skeleton adapter ready

# ============ Firebase (Google sign-in for the website) ============
# Client-side web config (public values); VITE_* are baked into the dist build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server-side ID token verification for POST /api/auth/firebase.
FIREBASE_PROJECT_ID=
# OAuth 2.0 Web client ID(s) allowed as `aud` for mobile-app Google ID tokens.
GOOGLE_OAUTH_CLIENT_IDS=
