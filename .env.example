# ===== Try1Second backend environment =====
# Admin email-OTP login: the ONLY emails that can open /admininsta (comma-separated)
ADMIN_EMAILS=standardpetro.in@gmail.com,k.manishkumar2009@gmail.com
# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Sender address. NOTE: until you verify a domain at resend.com/domains,
# Resend only delivers to the account owner (standardpetro.in@gmail.com).
# After verifying try1second.com set e.g. MAIL_FROM="Try1Second <no-reply@try1second.com>"
MAIL_FROM=onboarding@resend.dev
# ===== Production (KVM4) =====
# MYSQL_URL=mysql://user:pass@127.0.0.1:3306/try1second
# REDIS_URL=redis://127.0.0.1:6379
# SESSION_SECRET=<random 64+ chars>

# ===== Google sign-in (Firebase) =====
# Create a project at console.firebase.google.com → Authentication → enable Google provider
# Backend verifies Google ID tokens; only the project ID is needed here:
FIREBASE_PROJECT_ID=try1second
# Frontend (build-time, public values — paste into the web app config):
# VITE_FIREBASE_API_KEY=AIza...
# VITE_FIREBASE_AUTH_DOMAIN=try1second.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=try1second
# VITE_FIREBASE_APP_ID=1:123:web:abc

# ===== VCommission affiliate feed =====
VCOMMISSION_API_KEY=
