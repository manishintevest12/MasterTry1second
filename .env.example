ADMITAD_DEFAULT_CAMPAIGN_ID=    # optional fallback campaign for deeplinks
ADMITAD_BASE_URL=https://api.admitad.com
ADMITAD_SCOPE=advcampaigns_for_website coupons_for_website

VCOMMISSION_API_KEY=
VCOMMISSION_BASE_URL=https://api.vcommission.com/v2

CUELINKS_API_KEY=               # skeleton adapter ready
CUELINKS_CAMPAIGN_ID=
CUELINKS_SUB_ID=

