# ============ Try1Second — environment template ============
# Core
DATABASE_URL=mysql://user:pass@host:3306/dbname
REDIS_URL=                      # optional; L1+MySQL work without it
GEMINI_API_KEY=                 # optional AI query-understanding

# Affiliate networks — add credentials as each publisher account is approved.
# Sync auto-enables per network the moment its key pair is present.
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=
ADMITAD_WEBSITE_ID=             # Admitad website (ad space) id
ADMITAD_DEFAULT_CAMPAIGN_ID=    # optional fallback campaign for deeplinks
ADMITAD_BASE_URL=https://api.admitad.com
ADMITAD_SCOPE=advcampaigns_for_website coupons_for_website

VCOMMISSION_API_KEY=
VCOMMISSION_BASE_URL=https://api.vcommission.com/v2

# Cuelinks (one of SEVEN claiming layers, not the only partner)
CUELINKS_API_KEY=
CUELINKS_CAMPAIGN_ID=
CUELINKS_SUB_ID=                # optional: shows up in reports as the sub id
CUELINKS_EXTRA_MERCHANTS=       # csv of joined domains, e.g. "cleartrip.com,redbus.in"
CUELINKS_ALL_MERCHANTS=         # 1 = wrap every merchant domain
CUELINKS_ONLY_JOINED=           # 1 = only merchants measured as joined
CUELINKS_DEEP_FIRST=            # 1 = prefer the deep linkkit path

# Extra networks: one merchant allow-list + one template each, {DESTINATION} is replaced.
# A merchant is paid by the network it was actually joined on, never double-counted.
ADMITAD_MERCHANTS=              # csv, e.g. "flipkart.com,myntra.com"
ADMITAD_LINK_TEMPLATE=          # e.g. https://ad.admitad.com/g/<hash>/?ulp={DESTINATION}
VCOMMISSION_MERCHANTS=
VCOMMISSION_LINK_TEMPLATE=
INRDEALS_MERCHANTS=
INRDEALS_LINK_TEMPLATE=
CJ_MERCHANTS=                   # optional; booking.com already rides the built-in CJ link
CJ_LINK_TEMPLATE=

# LinkInR (local campaign registry; pays today on the merchants it holds)
LINKINR_ENABLED=                # 0 disables the layer
LINKINR_SUB_ID=                 # optional sub id, defaults to try1second

# EarnKaro / Ekaro converter (catches grocery + food retailers no other network carries)
EKARO_API_KEY=

# Amazon Associates (built-in default tag; override only if the account changes)
AMAZON_ASSOCIATES_TAG=

# ============ AdSense (the second revenue engine) ============
# Without a client + slot id NO ad unit renders anywhere and traffic cannot earn.
# A per-unit override wins over the default slot: <SLOT_KEY>_AD_SLOT, e.g. VERTICAL_FLIGHTS_AD_SLOT.
ADSENSE_CLIENT=                 # ca-pub-3144522772064172
ADSENSE_SLOT=                   # numeric unit id from AdSense -> Ads -> By ad unit
HOME_FEED_AD_SLOT=
VERTICAL_FEED_AD_SLOT=
REDIRECT_AD_SLOT=               # the exit interstitial's unit

# OPTIMISE_API_KEY=             # skeleton adapter ready

# ============ Firebase (Google sign-in for the website) ============
# Client-side web config (public values); VITE_* are baked into the dist build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server-side ID token verification for POST /api/auth/firebase.
FIREBASE_PROJECT_ID=
# OAuth 2.0 Web client ID(s) allowed as `aud` for mobile-app Google ID tokens.
GOOGLE_OAUTH_CLIENT_IDS=
